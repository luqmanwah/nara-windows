{
  "schemaVersion": "1.0.0",
  "product": "Nara Windows Deployment",
  "distribution": "github-releases-only",
  "channels": {
    "stable": { "enabled": false, "latest": null },
    "preview": { "enabled": false, "latest": null },
    "development": { "enabled": true, "latest": "0.1.1-development" }
