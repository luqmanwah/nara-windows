{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nara.local/schemas/playbook-signature.schema.json",
  "title": "Nara Detached Playbook Signature",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "keyId", "algorithm", "contentSha256", "signatureBase64"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "keyId": { "type": "string", "minLength": 1 },
    "algorithm": { "const": "ecdsa-p256-sha256" },
    "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signatureBase64": { "type": "string", "minLength": 80, "maxLength": 128 }
  }
}
