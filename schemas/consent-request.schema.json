{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nara.local/schemas/consent-request.schema.json",
  "title": "Nara Signed Consent Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "requestId", "installationId", "brokerKeyId", "status", "createdAtUtc",
    "expiresAtUtc", "actionPlanSha256", "playbookSha256", "playbookSignatureKeyId",
    "approvalMode", "actions", "consentStatement", "signatureAlgorithm", "requestSignatureBase64"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "requestId": { "type": "string", "format": "uuid" },
    "installationId": { "type": "string", "format": "uuid" },
    "brokerKeyId": { "type": "string", "format": "uuid" },
    "status": { "const": "awaiting-user-consent" },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" },
    "actionPlanSha256": { "$ref": "#/$defs/sha256" },
    "playbookSha256": { "$ref": "#/$defs/sha256" },
    "playbookSignatureKeyId": { "type": "string", "minLength": 1 },
    "approvalMode": { "const": "recommended" },
    "actions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "description", "risk", "requiresAdmin", "resourceImpact", "verification", "rollback"],
        "properties": {
          "id": { "type": "string", "pattern": "^NARA-[A-Z0-9]+(?:-[A-Z0-9]+)+$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "risk": { "enum": ["low", "medium", "high"] },
          "requiresAdmin": { "type": "boolean" },
          "resourceImpact": { "type": "string", "minLength": 1 },
          "verification": { "$ref": "#/$defs/stringList" },
          "rollback": { "$ref": "#/$defs/stringList" }
        }
      }
    },
    "consentStatement": { "const": "I reviewed these exact actions and request a simulation-only approval receipt." },
    "signatureAlgorithm": { "const": "ecdsa-p256-sha256" },
    "requestSignatureBase64": { "type": "string", "minLength": 80, "maxLength": 128 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
