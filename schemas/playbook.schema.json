{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nara.local/schemas/playbook.schema.json",
  "title": "Nara Declarative Playbook",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "playbookId", "playbookVersion", "adapter", "description", "actions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "playbookId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "playbookVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "adapter": { "const": "fake-windows" },
    "description": { "type": "string", "minLength": 1, "maxLength": 240 },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "operations"],
        "properties": {
          "ruleId": { "type": "string", "pattern": "^NARA-[A-Z0-9]+(?:-[A-Z0-9]+)+$" },
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["setting", "valueType", "expected", "desired"],
              "properties": {
                "setting": {
                  "enum": ["ui.animations", "ui.transparency", "ai.runtimeMode", "ai.idleUnloadMinutes"]
                },
                "valueType": { "enum": ["boolean", "string", "integer"] },
                "expected": { "type": ["boolean", "string", "integer"] },
                "desired": { "type": ["boolean", "string", "integer"] }
              }
            }
          }
        }
      }
    }
  }
}
