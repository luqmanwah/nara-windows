{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nara.local/schemas/transaction-report.schema.json",
  "title": "Nara Transaction Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engineVersion",
    "transactionId",
    "simulation",
    "status",
    "startedAtUtc",
    "finishedAtUtc",
    "actionPlanSha256",
    "playbookSha256",
    "playbookSignatureKeyId",
    "approvalId",
    "approvalSessionNonce",
    "installationId",
    "consentRequestSha256",
    "changed",
    "stateBeforeSha256",
    "stateAfterSha256",
    "appliedActionIds",
    "revertedActionIds",
    "errors",
    "ledgerFirstSequence",
    "ledgerLastSequence"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "engineVersion": { "type": "string", "minLength": 1 },
    "transactionId": { "type": "string", "format": "uuid" },
    "simulation": { "const": true },
    "status": { "enum": ["committed", "reverted", "rejected"] },
    "startedAtUtc": { "type": "string", "format": "date-time" },
    "finishedAtUtc": { "type": "string", "format": "date-time" },
    "actionPlanSha256": { "$ref": "#/$defs/sha" },
    "playbookSha256": { "$ref": "#/$defs/sha" },
    "playbookSignatureKeyId": { "type": "string", "minLength": 1 },
    "approvalId": { "type": "string", "format": "uuid" },
    "approvalSessionNonce": { "type": "string", "format": "uuid" },
    "installationId": { "type": "string", "format": "uuid" },
    "consentRequestSha256": { "$ref": "#/$defs/sha" },
    "changed": { "type": "boolean" },
    "stateBeforeSha256": { "$ref": "#/$defs/sha" },
    "stateAfterSha256": { "$ref": "#/$defs/sha" },
    "appliedActionIds": { "$ref": "#/$defs/actionIds" },
    "revertedActionIds": { "$ref": "#/$defs/actionIds" },
    "errors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "ledgerFirstSequence": { "type": "integer", "minimum": 1 },
    "ledgerLastSequence": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "actionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^NARA-[A-Z0-9]+(?:-[A-Z0-9]+)+$" }
    }
  }
}
